# Docker 镜像版本（见 https://github.com/yangchuansheng/eaglerXserver/releases）
IMAGE_TAG=2.2.3

# 容器名称
CONTAINER_NAME=eaglercraft

# Minecraft 版本：1.8 或 1.12
MINECRAFT_VERSION=1.12

# 管理面板密码（必填，用于 http://<host>:5201/admin）
RCON_PASSWORD=change-this-password

# 宿主机端口映射
GAME_PORT=5200
ADMIN_PORT=5201

# 世界数据持久化目录（挂载到容器 /eaglerX-1.8-server）
DATA_DIR=./data
